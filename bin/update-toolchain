# ── 12. CACHE CLEANUP ────────────────────────────────────────────────────────
# Safe caches — regenerated automatically on next use, no data loss.
# Audited 2026-06-06: these were consuming 15-20 GB between runs.
phase "Cache cleanup"

cache_clean() {
  local label="$1" path="$2"
  if [[ -d "$path" ]]; then
    if $DRY; then
      echo "  (dry-run) rm -rf $path/*"
    else
      find "$path" -mindepth 1 -delete 2>/dev/null && ok "cleared: $label ($path)" || warn "could not clear: $label"
    fi
  fi
}

# pip — wheel/sdist cache, fully safe to clear
if require pip3 "brew install python"; then
  if $DRY; then echo "  (dry-run) python3 -m pip cache purge"
  else python3 -m pip cache purge 2>/dev/null && ok "pip cache purged" || warn "pip cache purge failed"; fi
fi

# uv — package cache, safe (uv re-downloads on next use)
if require uv "brew install uv"; then
  if $DRY; then echo "  (dry-run) uv cache clean"
  else uv cache clean 2>/dev/null && ok "uv cache cleaned" || warn "uv cache clean failed"; fi
fi

# AWS CLI response cache — stale API responses, safe
cache_clean "aws-cli"   "$HOME/Library/Caches/aws"

# AWS CDK jsii — JS interop cache, regenerated on next cdk synth
cache_clean "aws-jsii"  "$HOME/Library/Caches/com.amazonaws.jsii"

# Trivy vulnerability DB — re-downloaded on next scan (always wants fresh anyway)
cache_clean "trivy"     "$HOME/Library/Caches/trivy"

# Comet ML — stale experiment tracker cache
cache_clean "comet"     "$HOME/Library/Caches/Comet"

# go build cache — safe, rebuilt on next go build
if require go "brew install go"; then
  if $DRY; then echo "  (dry-run) go clean -cache"
  else go clean -cache 2>/dev/null && ok "go build cache cleared" || warn "go clean failed"; fi
fi

# Homebrew download cache — already handled by brew_cleanup_safe above (prune=7)
# but run again with --prune=all for a full clean
if $DRY; then echo "  (dry-run) brew cleanup --prune=all"
else brew cleanup --prune=all 2>/dev/null | grep "freed" | while IFS= read -r l; do ok "$l"; done || true; fi

log "Cache cleanup complete"

# ── 13. macOS Software Update ─────────────────────────────────────────────────
phase "macOS Software Update"
# Apple-signed updates delivered over TLS with code-signing verification.
# Only lists available updates — does NOT auto-install (requires sudo + reboot).
log "Checking for macOS updates (listing only — install manually or via System Settings)"
if $DRY; then
  echo "  (dry-run) softwareupdate --list"
else
  MACOS_UPDATES=$(softwareupdate --list 2>&1 || true)
  if echo "$MACOS_UPDATES" | grep -q "No new software available"; then
    ok "macOS: up to date"
  else
    warn "macOS updates available — install via System Settings → Software Update:"
    echo "$MACOS_UPDATES" | grep -E "^\s*\*|\bLabel\b" | while IFS= read -r line; do
      warn "  $line"
    done
  fi
fi

# ── 14. RESTRICTED-NETWORK BINARIES ─────────────────────────────────────────────
# These tools cannot be updated via brew/npm/pip because their download URLs
# are blocked by a corporate TLS-inspecting proxy (the corporate proxy, Netskope, Palo Alto, etc.).
# Each tool here has a verified proxy-safe alternative path.
#
# Tools audited (2026-06-06):
#   ollama  — ollama.com/install.sh blocked → use GitHub releases tarball
#   claude  — downloads.claude.ai blocked   → npm works fine (in NPM_PINNED above)
#   rtk     — brew/Homebrew core            → unblocked, no special handling needed
#   llmfit  — brew/Homebrew core            → unblocked, no special handling needed
phase "Restricted-network binaries"

# ollama — brew-managed with GitHub releases fallback
# Primary: brew upgrade (ghcr.io bottles — verified working through TLS-inspecting proxies as of 2026-08-18)
# Fallback: GitHub releases tarball (ollama.com/install.sh is proxy-blocked)
# Note: registry.ollama.ai (model pulls) remains blocked — this only updates the binary.
update_ollama() {
  local current latest brew_latest
  current=$(ollama --version 2>/dev/null | awk '{print $NF}' || echo "0.0.0")

  # Check what brew thinks is latest
  brew_latest=$(brew info --json=v2 ollama 2>/dev/null \
    | python3 -c "import sys,json; print(json.load(sys.stdin)['formulae'][0]['versions']['stable'])" 2>/dev/null || echo "")

  if [[ -n "$brew_latest" && "$current" == "$brew_latest" ]]; then
    ok "ollama: already at $current (brew-managed)"
    return
  fi

  # ── Strategy 1: brew upgrade (preferred — SHA256 verified bottles) ──
  if [[ -n "$brew_latest" && "$current" != "$brew_latest" ]]; then
    log "ollama: $current → $brew_latest (via brew upgrade)"
    if $DRY; then
      echo "  (dry-run) brew upgrade ollama"
      return
    fi

    # Stop server before upgrade
    pkill -f "ollama serve" 2>/dev/null || true
    sleep 2

    if brew upgrade ollama 2>/dev/null; then
      ok "ollama: updated to $brew_latest via brew"
      # Restart server
      launchctl unload ~/Library/LaunchAgents/com.ollama.ollama.plist 2>/dev/null || true
      sleep 1
      launchctl load ~/Library/LaunchAgents/com.ollama.ollama.plist 2>/dev/null \
        || (ollama serve &>/usr/local/var/log/ollama.log &)
      record_sha "ollama-post" "$(command -v ollama)"
      return
    fi
    warn "ollama: brew upgrade failed — falling back to GitHub releases"
  fi

  # ── Strategy 2: GitHub releases tarball (fallback for proxy flakiness) ──
  latest=$(curl -sL "https://api.github.com/repos/ollama/ollama/releases/latest" \
    | python3 -c "import sys,json; print(json.load(sys.stdin)['tag_name'].lstrip('v'))" 2>/dev/null || echo "")

  if [[ -z "$latest" ]]; then
    warn "ollama: could not fetch latest version from GitHub API — skipping"
    return
  fi

  if [[ "$current" == "$latest" ]]; then
    ok "ollama: already at $current"
    return
  fi

  log "ollama: $current → $latest (via GitHub releases tarball — brew fallback)"
  if $DRY; then
    echo "  (dry-run) curl github.com/ollama/ollama/releases/download/v${latest}/ollama-darwin.tgz"
    return
  fi

  local tmp_dir tmp_tgz
  tmp_dir=$(mktemp -d)
  tmp_tgz="${tmp_dir}/ollama-darwin.tgz"

  if ! curl -fsSL "https://github.com/ollama/ollama/releases/download/v${latest}/ollama-darwin.tgz" \
      -o "$tmp_tgz"; then
    err "ollama: GitHub download also failed — likely proxy blocking. Try from hotspot."
    rm -rf "$tmp_dir"
    return
  fi


  # Verify GitHub release attestation (SLSA provenance) before installing
  if command -v gh &>/dev/null; then
    if timeout 30 gh attestation verify "$tmp_tgz" --repo ollama/ollama 2>/dev/null; then
      sec "ollama: GitHub attestation verified ✓"
    else
      warn "ollama: no attestation available — proceeding (verify SHA against release page)"
    fi
  fi

  tar -xzf "$tmp_tgz" -C "$tmp_dir"

  # Install into brew's Cellar so `brew link` keeps tracking it.
  # This avoids creating a rogue /usr/local/bin/ollama that shadows brew.
  local ollama_cellar
  ollama_cellar="$(brew --cellar)/ollama/${latest}/bin"
  if [[ ! -d "$ollama_cellar" ]]; then
    mkdir -p "$ollama_cellar" 2>/dev/null \
      || { sudo mkdir -p "$ollama_cellar" && sudo chown -R "$(whoami)" "$(brew --cellar)/ollama/${latest}"; }
  fi

  # Stop server before replacing binary
  pkill -f "ollama serve" 2>/dev/null || true
  sleep 2

  cp "${tmp_dir}/ollama" "$ollama_cellar/ollama" \
    && chmod +x "$ollama_cellar/ollama" \
    && brew link --overwrite ollama 2>/dev/null \
    && ok "ollama: updated to $latest (GitHub → brew Cellar)" \
    || err "ollama: failed to install binary into brew Cellar"

  rm -rf "$tmp_dir"

  # Restart server via launchctl
  launchctl unload ~/Library/LaunchAgents/com.ollama.ollama.plist 2>/dev/null || true
  sleep 1
  launchctl load ~/Library/LaunchAgents/com.ollama.ollama.plist 2>/dev/null \
    || (ollama serve &>/usr/local/var/log/ollama.log &)

  record_sha "ollama-post" "$(command -v ollama)"
}

if require ollama "see: https://github.com/ollama/ollama/releases"; then
  record_sha "ollama-pre" "$(command -v ollama)"
  update_ollama
fi


# ── 15. SUPPLY-CHAIN VERIFICATION ────────────────────────────────────────────
# Post-update verification layer. Verifies provenance, scans for embedded vulns,
# and detects unexpected binary mutations between runs.
# References: SLSA v1.0 consumer verification, NIST SP 800-218 (SSDF), CISA attestation guidance.
phase "SUPPLY-CHAIN VERIFICATION"

# ── 15a. Homebrew Sigstore Provenance Verification (Gap 1) ────────────────────
# Industry practice: Verify Sigstore attestations independently, don't just trust
# the package manager's internal checks. Homebrew bottles from homebrew-core have
# SLSA L3 provenance attestations since May 2024.
sec "Verifying Homebrew bottle provenance (Sigstore attestations)…"
PROVENANCE_FORMULAE=()
while IFS= read -r _line; do
  [[ -n "$_line" ]] && PROVENANCE_FORMULAE+=("$_line")
done < <(load_list "provenance-formulae")

if $DRY; then
  echo "  (dry-run) brew verify <formula> for ${#PROVENANCE_FORMULAE[@]} critical tools"
else
  PROVENANCE_PASS=0
  PROVENANCE_FAIL=0
  for formula in "${PROVENANCE_FORMULAE[@]}"; do
    if brew list --formula "$formula" &>/dev/null; then
      if brew verify "$formula" 2>/dev/null; then
        sec "  ✓ provenance verified: $formula"
        ((PROVENANCE_PASS++))
      else
        warn "  ✗ no provenance or verification failed: $formula"
        ((PROVENANCE_FAIL++))
      fi
    fi
  done
  if (( PROVENANCE_FAIL == 0 )); then
    ok "Homebrew provenance: all ${PROVENANCE_PASS} critical formulae verified"
  else
    warn "Homebrew provenance: ${PROVENANCE_PASS} verified, ${PROVENANCE_FAIL} unverified"
  fi
fi

# ── 15b. npm Provenance Signature Verification (Gap 2) ────────────────────────
# Industry practice: `npm audit signatures` verifies Sigstore attestations on
# installed packages — different from `npm audit` (which checks CVEs).
# npm provenance (GA Oct 2023) proves packages were built from their claimed source repo.
if require npm "brew install node"; then
  log "npm audit signatures (Sigstore provenance verification)"
  if $DRY; then
    echo "  (dry-run) npm audit signatures --global"
  else
    NPM_SIG_OUT=$(npm audit signatures 2>&1 || true)
    if echo "$NPM_SIG_OUT" | grep -qi "verified"; then
      ok "npm signatures: all global packages have valid registry signatures"
    elif echo "$NPM_SIG_OUT" | grep -qi "missing"; then
      warn "npm signatures: some packages lack provenance attestations:"
      echo "$NPM_SIG_OUT" | grep -i "missing\|invalid" | head -10 | while IFS= read -r line; do
        warn "  $line"
      done
    else
      warn "npm audit signatures: unexpected output — review manually"
    fi
  fi
fi

# ── 15c. GitHub Release Attestation Verification (Gap 3) ─────────────────────
# Industry practice: Verify SLSA provenance for binaries downloaded from GitHub Releases.
# `gh attestation verify` checks Sigstore-based artifact attestations.
# Critical for the corporate proxy-fallback downloads where we bypass brew's verification.
if require gh "brew install gh"; then
  sec "Verifying GitHub release attestations for key binaries…"

  # Binaries sourced from GitHub Releases (not exclusively brew)
  # Using parallel arrays instead of associative array for bash 3.2 / set -u compatibility
  GH_ATTEST_BINS=("ollama" "gh")
  GH_ATTEST_REPOS=("ollama/ollama" "cli/cli")

  if $DRY; then
    echo "  (dry-run) gh attestation verify for ${#GH_ATTEST_BINS[@]} binaries"
  else
    for i in "${!GH_ATTEST_BINS[@]}"; do
      bin_name="${GH_ATTEST_BINS[$i]}"
      repo="${GH_ATTEST_REPOS[$i]}"
      bin_path=$(command -v "$bin_name" 2>/dev/null || true)
      if [[ -n "$bin_path" ]]; then
        if timeout 30 gh attestation verify "$bin_path" --repo "$repo" 2>/dev/null; then
          sec "  ✓ GitHub attestation verified: $bin_name ($repo)"
        else
          # Not all releases have attestations — warn but don't fail
          warn "  ✗ no GitHub attestation: $bin_name ($repo) — may not publish attestations yet"
        fi
      fi
    done
  fi
fi

# ── 15d. SBOM Generation + Binary Vulnerability Scanning (Gap 4) ─────────────
# Industry practice: Generate CycloneDX/SPDX SBOMs of installed binaries, then
# scan embedded dependencies for known CVEs using grype.
# This catches vulnerabilities INSIDE compiled binaries (e.g., a Go binary with
# a vulnerable net/http dependency baked in at compile time).
if require syft "brew install syft"; then
  log "SBOM-based binary vulnerability scan"
  SBOM_FILE="${LOG_DIR}/toolchain-sbom-$(date -u +%Y%m%d).json"

  if $DRY; then
    echo "  (dry-run) syft dir:${BREW_PREFIX}/bin -o cyclonedx-json > ${SBOM_FILE}"
    echo "  (dry-run) grype sbom:$SBOM_FILE --only-fixed --fail-on high"
  else
    log "  Generating SBOM for $BREW_PREFIX/bin…"
    if syft dir:"$BREW_PREFIX"/bin -o cyclonedx-json > "$SBOM_FILE" 2>/dev/null; then
      ok "  SBOM generated: $SBOM_FILE ($(wc -l < "$SBOM_FILE") lines)"

      if require grype "brew install grype"; then
        GRYPE_OUT=$(grype "sbom:$SBOM_FILE" --only-fixed 2>&1 || true)
        GRYPE_HIGH=$(echo "$GRYPE_OUT" | grep -c "High\|Critical" || true)
        if (( GRYPE_HIGH == 0 )); then
          ok "  grype: no high/critical fixable vulns in toolchain binaries"
        else
          warn "  grype: $GRYPE_HIGH high/critical fixable vulnerabilities found:"
          echo "$GRYPE_OUT" | grep "High\|Critical" | head -10 | while IFS= read -r line; do
            warn "    $line"
          done
        fi
      fi
    else
      warn "  syft SBOM generation failed — skipping grype scan"
    fi
  fi
else
  warn "syft not installed — install for SBOM-based binary scanning: brew install syft"
fi

# ── 15e. macOS Code Signature Verification (Gap 5) ───────────────────────────
# Industry practice: Verify Apple codesign validity on binaries that should be signed.
# Unsigned/invalid signatures may indicate binary replacement or tampering.
# Note: Most Homebrew CLI tools are NOT Apple-signed — focus on commercial/vendor tools.
sec "Verifying code signatures on signed binaries…"
CODESIGN_TARGETS=()
while IFS= read -r _line; do
  [[ -n "$_line" ]] && CODESIGN_TARGETS+=("$_line")
done < <(load_list "codesign-targets")

if $DRY; then
  echo "  (dry-run) codesign -v for ${#CODESIGN_TARGETS[@]} binaries"
else
  for bin in "${CODESIGN_TARGETS[@]}"; do
    if [[ -f "$bin" || -d "$bin" ]]; then
      if codesign -v "$bin" 2>/dev/null; then
        sec "  ✓ codesign valid: $(basename "$bin")"
      else
        # Check if it's unsigned (expected for brew CLIs) vs invalid (red flag)
        CS_OUT=$(codesign -v "$bin" 2>&1 || true)
        if echo "$CS_OUT" | grep -q "not signed"; then
          # Expected for many Homebrew tools — just log, don't warn
          log "  · unsigned (expected): $(basename "$bin")"
        else
          warn "  ✗ codesign INVALID: $bin"
          warn "    $CS_OUT"
        fi
      fi
    fi
  done
fi

# ── 15f. Binary SHA Diff Alerting (Gap 6) ────────────────────────────────────
# Industry practice: Detect unexpected binary changes between runs.
# A SHA change without a corresponding update in the log is a RED FLAG
# indicating possible binary replacement/tampering.
sec "Comparing binary SHAs against previous run baseline…"
compare_sha_baseline() {
  if [[ ! -f "$SHA_FILE" ]]; then
    log "  No SHA baseline file — first run, nothing to compare"
    return
  fi

  # Group final: entries by DATE (YYYY-MM-DD), not exact timestamp.
  # A single run's final: entries may span multiple seconds (same run = same date).
  local -a run_dates=()
  while IFS= read -r _date_line; do
    [[ -n "$_date_line" ]] && run_dates+=("$_date_line")
  done < <(grep "^20.*final:" "$SHA_FILE" | awk '{print substr($1,1,10)}' | sort -u | tail -2)

  if (( ${#run_dates[@]} < 2 )); then
    log "  Only one run date recorded — nothing to compare yet"
    return
  fi

  local prev_date="${run_dates[0]}"
  local curr_date="${run_dates[1]}"
  local changes=0
  local unexplained=0

  sec "  Comparing runs: $prev_date → $curr_date"

  # Compare current run's final entries against previous run
  while IFS=' ' read -r ts label bin sha; do
    [[ "$label" != final:* ]] && continue

    local bin_name="${label#final:}"

    # Find same binary in previous run
    local prev_sha
    prev_sha=$(grep "^${prev_date}.*${label} ${bin} " "$SHA_FILE" 2>/dev/null | tail -1 | awk '{print $4}')

    if [[ -z "$prev_sha" ]]; then
      # Binary not in previous run — new addition, skip
      continue
    fi

    if [[ "$prev_sha" != "$sha" ]]; then
      ((changes++))
      # Check if there was a logged update for this binary in today's log
      local update_logged=false
      if grep -q "${bin_name}" "$LOG_FILE" 2>/dev/null; then
        update_logged=true
      fi
      # Also check if pre→post SHA change was recorded today
      if grep "^${curr_date}" "$SHA_FILE" 2>/dev/null | grep -q "${bin_name}-pre\|${bin_name}-post"; then
        update_logged=true
      fi

      if $update_logged; then
        sec "  ✓ $bin_name: SHA changed (update logged)"
      else
        ((unexplained++))
        err "  ⚠️  $bin_name: SHA CHANGED WITHOUT LOGGED UPDATE!"
        err "      Binary: $bin"
        err "      Old:    $prev_sha"
        err "      New:    $sha"
        err "      ACTION: Verify this binary — possible tampering!"
      fi
    fi
  done < <(grep "^${curr_date}.*final:" "$SHA_FILE")

  if (( unexplained > 0 )); then
    err "  ALERT: $unexplained unexplained binary SHA changes detected!"
    err "  Review $SHA_FILE and investigate before trusting these binaries."
  elif (( changes > 0 )); then
    ok "  Binary diff: $changes changes, all explained by logged updates"
  else
    ok "  Binary diff: no changes since last run"
  fi
}
compare_sha_baseline

# ── 15g. Go Binary Vulnerability Scanning (Gap 7) ────────────────────────────
# Industry practice: Run `govulncheck -mode=binary` on installed Go binaries.
# Go binaries embed their full dependency tree at compile time — govulncheck
# inspects the binary's debug info to find vulnerable stdlib/module dependencies.
# Most security tools (trivy, gh, gitleaks, osv-scanner, ollama) are Go binaries.
if require go "brew install go"; then
  # govulncheck installs to GOPATH/bin (~/go/bin) which may not be in PATH
  GOBIN="${GOPATH:-$HOME/go}/bin"
  GOVULNCHECK_BIN=$(command -v govulncheck 2>/dev/null || true)
  [[ -z "$GOVULNCHECK_BIN" && -x "$GOBIN/govulncheck" ]] && GOVULNCHECK_BIN="$GOBIN/govulncheck"
  if [[ -z "$GOVULNCHECK_BIN" ]]; then
    log "Installing govulncheck…"
    if ! $DRY; then
      go install golang.org/x/vuln/cmd/govulncheck@latest 2>/dev/null || true
      GOVULNCHECK_BIN=$(command -v govulncheck 2>/dev/null || true)
      [[ -z "$GOVULNCHECK_BIN" && -x "$GOBIN/govulncheck" ]] && GOVULNCHECK_BIN="$GOBIN/govulncheck"
    fi
  fi

  if [[ -n "$GOVULNCHECK_BIN" ]]; then
    log "govulncheck: scanning Go-compiled binaries for embedded vulnerabilities"

    # Critical Go binaries to scan (security tools + frequently-used CLIs)
    GO_BINARY_SCAN_LIST=(
      "trivy"
      "gh"
      "gitleaks"
      "osv-scanner"
      "ollama"
      "syft"
      "grype"
      "cosign"
      "kubectx"
      "stern"
    )

    if $DRY; then
      echo "  (dry-run) govulncheck -mode=binary for ${#GO_BINARY_SCAN_LIST[@]} Go binaries"
    else
      GOVULN_CLEAN=0
      GOVULN_VULN=0
      for bin_name in "${GO_BINARY_SCAN_LIST[@]}"; do
        bin_path=$(command -v "$bin_name" 2>/dev/null || true)
        if [[ -n "$bin_path" ]]; then
          # Quick check: is this actually a Go binary?
          if file "$bin_path" 2>/dev/null | grep -q "Mach-O\|ELF"; then
            VULN_OUT=$("$GOVULNCHECK_BIN" -mode=binary "$bin_path" 2>&1 || true)
            if echo "$VULN_OUT" | grep -q "No vulnerabilities found"; then
              sec "  ✓ $bin_name: no known vulns"
              ((GOVULN_CLEAN++))
            elif echo "$VULN_OUT" | grep -q "Vulnerability #"; then
              VULN_COUNT=$(echo "$VULN_OUT" | grep -c "Vulnerability #" || echo "?")
              warn "  ✗ $bin_name: $VULN_COUNT vulnerabilities found"
              # Show first 3 CVEs
              echo "$VULN_OUT" | grep -A1 "Vulnerability #" | head -9 | while IFS= read -r line; do
                warn "    $line"
              done
              ((GOVULN_VULN++))
            else
              log "  · $bin_name: scan completed (no definitive result)"
              ((GOVULN_CLEAN++))
            fi
          fi
        fi
      done
      if (( GOVULN_VULN == 0 )); then
        ok "govulncheck: all ${GOVULN_CLEAN} Go binaries clean"
      else
        warn "govulncheck: $GOVULN_VULN binaries have known vulnerabilities (update via brew)"
      fi
    fi
  else
    warn "govulncheck not available — install: go install golang.org/x/vuln/cmd/govulncheck@latest"
  fi
fi

# ── 15h. Cargo/Rust Supply-Chain Audit (Gap 8) ────────────────────────────────
# Industry practice: crates.io has NO Sigstore support. Use cargo-audit (RustSec
# advisory DB) to scan for vulnerable dependencies in cargo-installed binaries.
# Also check for recently published crates with suspicious patterns.
if require cargo "see: rustup.rs"; then
  log "Cargo supply-chain audit (RustSec advisory database)"

  if cargo audit --version &>/dev/null 2>&1; then
    if $DRY; then
      echo "  (dry-run) cargo audit"
    else
      CARGO_AUDIT_OUT=$(cargo audit 2>&1 || true)
      if echo "$CARGO_AUDIT_OUT" | grep -q "0 vulnerabilities found\|No vulnerable packages found"; then
        ok "cargo audit: no known vulnerabilities in cargo-installed crates"
      elif echo "$CARGO_AUDIT_OUT" | grep -qi "vulnerability\|warning"; then
        CARGO_VULN_COUNT=$(echo "$CARGO_AUDIT_OUT" | grep -c "^ID:" || echo "?")
        warn "cargo audit: $CARGO_VULN_COUNT advisories found:"
        echo "$CARGO_AUDIT_OUT" | grep -A2 "^ID:\|^Crate:\|^Version:" | head -15 | while IFS= read -r line; do
          warn "  $line"
        done
      fi
    fi
  else
    warn "cargo-audit not installed — install: cargo install cargo-audit"
    warn "  Catches RustSec advisories in cargo-installed binaries"
  fi

  # Also list cargo-installed binaries for audit trail
  log "  Cargo-installed binaries:"
  cargo install --list 2>/dev/null | grep -E "^[a-z]" | while IFS= read -r line; do
    log "    $line"
  done
fi

log "Supply-chain verification complete"
# ── 16. POST-RUN SHA SNAPSHOT ─────────────────────────────────────────────────
phase "Recording binary SHA256 snapshot"
BINARIES_TO_RECORD=()
while IFS= read -r _line; do
  [[ -n "$_line" ]] && BINARIES_TO_RECORD+=("$_line")
done < <(load_list "record-binaries")
for bin in "${BINARIES_TO_RECORD[@]}"; do
  bin_path=$(command -v "$bin" 2>/dev/null || true)
  if [[ -n "$bin_path" ]]; then
    record_sha "final:$bin" "$bin_path"
    sec "  SHA256 recorded: $bin → $bin_path"
  fi
done
log "SHA snapshot → $SHA_FILE"


_finish

log "Next: review any [warn] lines above; '--audit' re-checks security posture at any time."
