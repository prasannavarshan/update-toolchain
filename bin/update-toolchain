# ── 10. pipx (Python CLI tools) + pip-audit (PyPI supply-chain scanning) ──────
phase "pipx"
# pipx installs each tool in an isolated venv — reduces cross-contamination risk.
# Each package is fetched from PyPI over TLS; hashes verified by pip.
#
# pip-audit scans every pipx venv against:
#   - PyPA Advisory Database (authoritative Python CVE source)
#   - GitHub Advisory Database
#   - NIST NVD
# This catches TeamPCP / PyPI supply-chain attacks (malicious package versions
# that execute code on install or import — same class as event-stream for npm).
if require pipx "brew install pipx"; then
  run "pipx upgrade-all" pipx upgrade-all

  # Scan all pipx-managed venvs for known-vulnerable packages
  log "pip-audit: scanning pipx venvs for PyPI supply-chain vulnerabilities"
  PIPX_VENVS=$(pipx environment --value PIPX_LOCAL_VENVS 2>/dev/null || echo "")
  if [[ -n "$PIPX_VENVS" && -d "$PIPX_VENVS" ]]; then
    if require pip-audit "pipx install pip-audit"; then
      if $DRY; then
        echo "  (dry-run) pip-audit --path $PIPX_VENVS"
      else
        # Scan each venv individually so one failure doesn't block the rest
        find "$PIPX_VENVS" -maxdepth 2 -name "pip-audit" -prune -o \
          -maxdepth 1 -mindepth 1 -type d -print | while IFS= read -r venv_dir; do
          venv_name=$(basename "$venv_dir")
          pip_bin="$venv_dir/lib/python*/site-packages"
          # Use pip-audit with the venv's pip
          if [[ -x "$venv_dir/bin/pip" ]]; then
            log "  pip-audit: $venv_name"
            "$venv_dir/bin/pip-audit" 2>/dev/null \
              || pip-audit --path "$venv_dir" 2>/dev/null \
              || warn "  pip-audit: could not scan $venv_name"
          fi
        done
        # Also run a broad scan across all pipx venvs at once
        pip-audit --path "$PIPX_VENVS" 2>/dev/null \
          && ok "pip-audit: all pipx venvs clean" \
          || warn "pip-audit: vulnerabilities found in pipx venvs — review above output"
      fi
    else
      warn "pip-audit not installed — install with: pipx install pip-audit"
      warn "  pip-audit catches PyPI supply-chain attacks (TeamPCP/event-stream class)"
    fi
  else
    warn "No pipx venvs found at $PIPX_VENVS — nothing to audit"
  fi
else
  warn "pipx not installed — recommended for isolated Python CLI tools"
  warn "  Install: brew install pipx && pipx ensurepath"
fi

# ── pip-audit: project-level reminder ─────────────────────────────────────────
# This script audits your TOOLCHAIN venvs. For project-level PyPI supply-chain
# protection (requirements.txt, uv.lock, pyproject.toml), run Ayyanar:
#   trivy fs .              — broadest coverage (Python, Node, Go, IaC)
#   osv-scanner --recursive . — lockfile-precise (uv.lock, Cargo.lock, go.sum)
#   pip-audit -r requirements.txt
#   semgrep --config=p/supply-chain .  — reachability analysis
log "Reminder: for project-level PyPI scanning, run Ayyanar (trivy + osv-scanner + pip-audit + semgrep)"

