#!/usr/bin/env bash
# =============================================================================
# update-toolchain.sh — Supply-chain hardened dev toolchain updater
# macOS / Apple Silicon + Intel
#
# Threat model: SECURITY.md
# Usage:
#   ./update-toolchain.sh          # full update
#   ./update-toolchain.sh --dry    # dry-run (no changes)
#   ./update-toolchain.sh --audit  # security audit only, no updates
# =============================================================================
set -euo pipefail
IFS=$'\n\t'

# ── Ensure Go bin dir is in PATH (govulncheck, etc. install here) ─────────────
GOBIN="${GOPATH:-$HOME/go}/bin"
[[ -d "$GOBIN" ]] && export PATH="$GOBIN:$PATH"

# ── CLI flags ─────────────────────────────────────────────────────────────────
DRY=false
AUDIT_ONLY=false
JSON=false
COLOR_MODE=auto
for arg in "$@"; do
  case "$arg" in
    --dry)   DRY=true ;;
    --audit) AUDIT_ONLY=true ;;
    --json)  JSON=true ;;
    --color=always) COLOR_MODE=always ;;
    --color=never)  COLOR_MODE=never ;;
    --color=auto)   COLOR_MODE=auto ;;
    --help)
      echo "Usage: $0 [--dry] [--audit] [--json] [--color=auto|always|never]"
      echo "  --dry     Print commands without executing"
      echo "  --audit   Run security checks only, no updates"
      echo "  --json    Emit a machine-readable report on stdout; progress to stderr"
      echo "  --color   Colour policy. Default auto: on only when stdout is a"
      echo "            terminal and NO_COLOR is unset."
      exit 0 ;;
    *) echo "Unknown flag: $arg"; exit 1 ;;
  esac
done

# ── Config ────────────────────────────────────────────────────────────────────
# Allowlists live OUTSIDE this script so you never edit code to change policy.
# Resolution order per list:
#   1. $UPDATE_TOOLCHAIN_CONFIG/<name>
#   2. ${XDG_CONFIG_HOME:-~/.config}/update-toolchain/<name>
#   3. the bundled config/<name>.example  (so a fresh clone runs)
#
# Lists are plain newline-delimited text, NOT sourced shell. A config file can
# never execute code — deliberate, for a tool whose whole job is trust.
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
  _target=$(readlink "$SCRIPT_PATH")
  case "$_target" in
    /*) SCRIPT_PATH="$_target" ;;
    *)  SCRIPT_PATH="$(dirname "$SCRIPT_PATH")/$_target" ;;
  esac
done
SCRIPT_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
CONFIG_DIR="${UPDATE_TOOLCHAIN_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/update-toolchain}"
EXAMPLE_DIR="${SCRIPT_ROOT}/config"

BREW_PREFIX="$(brew --prefix 2>/dev/null || echo /usr/local)"

load_list() {
  # load_list <name>  → one entry per line on stdout
  local name="$1" src=""
  if [[ -f "${CONFIG_DIR}/${name}" ]]; then
    src="${CONFIG_DIR}/${name}"
  elif [[ -f "${EXAMPLE_DIR}/${name}.example" ]]; then
    src="${EXAMPLE_DIR}/${name}.example"
  else
    return 0
  fi
  sed -e 's/[[:space:]]*#.*$//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$src" \
    | grep -v '^$' \
    | sed -e "s|\${BREW_PREFIX}|${BREW_PREFIX}|g" \
    || true
}

# ── Colour and output routing ─────────────────────────────────────────────────
# Colour is on only when a human is plausibly reading: stdout is a terminal and
# NO_COLOR (https://no-color.org) is unset. Redirect to a file or a pipe and the
# escape codes disappear, so logs and CI output stay clean. Every status is also
# carried by a text label, never by colour alone.
_want_colour() {
  case "$COLOR_MODE" in
    never)  return 1 ;;
    always) return 0 ;;
  esac
  [[ -n "${NO_COLOR:-}" ]] && return 1
  [[ -t 1 ]] || return 1
  return 0
}
if _want_colour; then
  C_RESET=$'\033[0m';  C_BOLD=$'\033[1m';    C_DIM=$'\033[2m'
  C_BLUE=$'\033[1;34m'; C_YELLOW=$'\033[1;33m'; C_RED=$'\033[1;31m'
  C_GREEN=$'\033[1;32m'; C_MAGENTA=$'\033[1;35m'
else
  C_RESET=; C_BOLD=; C_DIM=; C_BLUE=; C_YELLOW=; C_RED=; C_GREEN=; C_MAGENTA=
fi

# In --json mode stdout carries the report and nothing else, so all human-facing
# output moves to stderr. fd 3 is "wherever prose goes".
if $JSON; then exec 3>&2; else exec 3>&1; fi

START_EPOCH=$(date +%s)

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_DIR="${HOME}/.local/share/update-toolchain"
mkdir -p "$LOG_DIR"
LOG_FILE="${LOG_DIR}/$(date -u +%Y%m%dT%H%M%SZ).log"
SHA_FILE="${LOG_DIR}/binary-shas.txt"

_ts()   { date -u +"%Y-%m-%dT%H:%M:%SZ"; }
log()   { printf "%s[update]%s %s\n" "$C_BLUE"    "$C_RESET" "$*" >&3; echo "[$(_ts)] [INFO]  $*" >> "$LOG_FILE"; }
warn()  { printf "%s[warn]%s  %s\n" "$C_YELLOW"  "$C_RESET" "$*" >&3; echo "[$(_ts)] [WARN]  $*" >> "$LOG_FILE"; }
err()   { printf "%s[error]%s %s\n" "$C_RED"     "$C_RESET" "$*" >&3; echo "[$(_ts)] [ERROR] $*" >> "$LOG_FILE"; }
ok()    { printf "%s[ok]%s    %s\n" "$C_GREEN"   "$C_RESET" "$*" >&3; echo "[$(_ts)] [OK]    $*" >> "$LOG_FILE"; }
sec()   { printf "%s[sec]%s   %s\n" "$C_MAGENTA" "$C_RESET" "$*" >&3; echo "[$(_ts)] [SEC]   $*" >> "$LOG_FILE"; }
die()   { err "$*"; _finish; exit 1; }
# Continuation lines: shown and logged, never tallied as findings of their own.
# One problem reported as three errors makes the counts useless for alerting.
detail(){ printf "%s        %s%s\n" "$C_DIM" "$*" "$C_RESET" >&3; echo "[$(_ts)] [DETAIL] $*" >> "$LOG_FILE"; }

# Phase markers give a sense of position without animation. They go to fd 3 and
# carry no carriage returns, so a redirected run reads back as a clean list.
PHASE_N=0
PHASE_TOTAL=16
phase() {
  PHASE_N=$((PHASE_N + 1))
  printf "\n%s[%d/%d]%s %s%s%s\n" \
    "$C_DIM" "$PHASE_N" "$PHASE_TOTAL" "$C_RESET" "$C_BOLD" "$1" "$C_RESET" >&3
  echo "[$(_ts)] [PHASE] $PHASE_N/$PHASE_TOTAL $1" >> "$LOG_FILE"
}

# ── Summary ───────────────────────────────────────────────────────────────────
# Counts are read back out of the log file rather than kept in shell variables.
# Every log call appends to that file, including calls made inside subshells and
# pipelines, where a variable increment would have been silently discarded.
_tally() {
  local n
  n=$(grep -c "\[$1\]" "$LOG_FILE" 2>/dev/null) || n=0
  printf '%s' "${n:-0}"
}

_hrule() { printf '%s%s%s\n' "$C_DIM" "$(printf '─%.0s' $(seq 1 64))" "$C_RESET" >&3; }

_summary() {
  local n_ok n_warn n_err n_sec elapsed mins secs mode verdict vcolour
  n_ok=$(_tally OK); n_warn=$(_tally WARN); n_err=$(_tally ERROR); n_sec=$(_tally SEC)

  elapsed=$(( $(date +%s) - START_EPOCH ))
  mins=$(( elapsed / 60 )); secs=$(( elapsed % 60 ))

  mode="update"
  $DRY && mode="dry-run"
  $AUDIT_ONLY && mode="audit"

  if [[ "$n_err" -gt 0 ]]; then
    verdict="ACTION REQUIRED"; vcolour="$C_RED"
  elif [[ "$n_warn" -gt 0 ]]; then
    verdict="REVIEW"; vcolour="$C_YELLOW"
  else
    verdict="CLEAN"; vcolour="$C_GREEN"
  fi

  printf '\n' >&3
  _hrule
  printf '%s  update-toolchain%s  %s%s · %dm %02ds%s\n' \
    "$C_BOLD" "$C_RESET" "$C_DIM" "$mode" "$mins" "$secs" "$C_RESET" >&3
  _hrule
  # Label + colour + count: the status is legible with colour stripped.
  printf '  %sok%s        %4d       %swarnings%s  %4d       %serrors%s  %4d\n' \
    "$C_GREEN" "$C_RESET" "$n_ok" \
    "$C_YELLOW" "$C_RESET" "$n_warn" \
    "$C_RED" "$C_RESET" "$n_err" >&3
  printf '  %ssecurity checks%s  %4d\n' "$C_MAGENTA" "$C_RESET" "$n_sec" >&3
  _hrule
  printf '  verdict   %s%s%s\n' "$vcolour" "$verdict" "$C_RESET" >&3
  printf '  log       %s%s%s\n' "$C_DIM" "$LOG_FILE" "$C_RESET" >&3
  printf '  shas      %s%s%s\n' "$C_DIM" "$SHA_FILE" "$C_RESET" >&3
  _hrule

  if [[ "$n_warn" -gt 0 || "$n_err" -gt 0 ]]; then
    printf '\n  %sunresolved:%s\n' "$C_BOLD" "$C_RESET" >&3
    grep -E "\[(WARN|ERROR)\]" "$LOG_FILE" 2>/dev/null \
      | sed -e 's/^[^ ]* \[/[/' -e 's/^/    /' >&3 || true
  fi
}

_json_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

_json_report() {
  local n_ok n_warn n_err n_sec mode first line
  n_ok=$(_tally OK); n_warn=$(_tally WARN); n_err=$(_tally ERROR); n_sec=$(_tally SEC)
  mode="update"; $DRY && mode="dry-run"; $AUDIT_ONLY && mode="audit"

  printf '{\n'
  printf '  "tool": "update-toolchain",\n'
  printf '  "mode": "%s",\n' "$mode"
  printf '  "started": "%s",\n' "$(date -u -r "$START_EPOCH" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
  printf '  "duration_seconds": %d,\n' "$(( $(date +%s) - START_EPOCH ))"
  printf '  "counts": { "ok": %d, "warnings": %d, "errors": %d, "security_checks": %d },\n' \
    "$n_ok" "$n_warn" "$n_err" "$n_sec"
  printf '  "log_file": "%s",\n' "$(_json_escape "$LOG_FILE")"
  printf '  "sha_file": "%s",\n' "$(_json_escape "$SHA_FILE")"
  printf '  "findings": [\n'
  first=1
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    local level text
    level=$(printf '%s' "$line" | sed -n 's/^[^ ]* \[\([A-Z]*\)\].*/\1/p')
    text=$(printf '%s' "$line" | sed -e 's/^[^ ]* \[[A-Z]*\][[:space:]]*//')
    [[ $first -eq 0 ]] && printf ',\n'
    first=0
    printf '    { "level": "%s", "message": "%s" }' "$level" "$(_json_escape "$text")"
  done < <(grep -E "\[(WARN|ERROR)\]" "$LOG_FILE" 2>/dev/null || true)
  [[ $first -eq 0 ]] && printf '\n'
  printf '  ]\n'
  printf '}\n'
}

# Every terminal path routes through here: audit early-exit, normal completion,
# and die. A run that failed is exactly when a machine-readable report matters,
# so --json emits on failure too.
_finish() {
  _summary
  if $JSON; then _json_report; fi
}

log "Log → $LOG_FILE"

# ── Sudo credential cache ─────────────────────────────────────────────────────
# Only needed for steps that actually mutate the system. --dry and --audit make
# no changes, so they must never prompt: that is what lets them run in CI, in a
# container, and in a stranger's first evaluation of this tool.
if $DRY || $AUDIT_ONLY; then
  log "Read-only mode — skipping sudo prompt"
else
  log "Requesting sudo credentials upfront (needed for brew cleanup + binary installs)"
  if ! sudo -v; then
    die "sudo authentication failed — re-run and enter your password when prompted"
  fi
  # Keep the sudo token alive in the background for long-running steps
  ( while true; do sudo -v; sleep 50; done ) &>/dev/null &
  SUDO_KEEPALIVE_PID=$!
  trap 'kill "$SUDO_KEEPALIVE_PID" 2>/dev/null' EXIT
fi

# ── Helpers ───────────────────────────────────────────────────────────────────
run() {
  # run <label> <cmd> [args…]
  local label="$1"; shift
  log "$label"
  if $DRY; then
    local IFS=' '   # script-wide IFS is $'\n\t'; $* would join argv with newlines
    echo "  (dry-run) $*"
  else
    if "$@"; then
      ok "$label"
    else
      err "Failed: $label (exit $?)"
    fi
  fi
}

require() {
  # require <binary> [install-hint]
  if ! command -v "$1" &>/dev/null; then
    warn "$1 not found — skipping (${2:-install it to enable this step})"
    return 1
  fi
  return 0
}

_other_writable() {
  # _other_writable <mode-string>  e.g. drwxr-xr-x
  # True only when the *other* class has write. In a 10-character mode string
  # that is position 9: 1 type + 3 user + 3 group + 3 other.
  #
  # Anything looser is worse than useless here. Matching two 'w's anywhere flags
  # every group-writable directory, which is Homebrew's own normal layout — and
  # a security check that fires on a correct machine teaches you to ignore it.
  local perms="$1"
  [[ ${#perms} -ge 10 ]] || return 1
  [[ "${perms:8:1}" == "w" ]]
}

record_sha() {
  # record_sha <label> <binary-path>
  local label="$1" bin="$2"
  if [[ -x "$bin" ]]; then
    local sha
    sha=$(shasum -a 256 "$bin" 2>/dev/null | awk '{print $1}')
    echo "$(_ts) $label $bin $sha" >> "$SHA_FILE"
  fi
}

# ── 1. ENVIRONMENT INTEGRITY CHECKS ──────────────────────────────────────────
phase "ENVIRONMENT INTEGRITY CHECKS"

# 1a. Verify Homebrew itself is from the official source
BREW_BIN=$(command -v brew 2>/dev/null || true)
if [[ -z "$BREW_BIN" ]]; then
  die "Homebrew not found. Install from https://brew.sh (verify the install script hash first)"
fi

BREW_REPO=$(brew --repository 2>/dev/null)
# Accept both HTTPS and SSH remotes pointing to the official Homebrew repo
ACTUAL_BREW_REMOTE=$(git -C "$BREW_REPO" remote get-url origin 2>/dev/null || echo "unknown")
case "$ACTUAL_BREW_REMOTE" in
  "https://github.com/Homebrew/brew" | \
  "https://github.com/Homebrew/brew.git" | \
  "git@github.com:Homebrew/brew" | \
  "git@github.com:Homebrew/brew.git")
    : ;; # trusted
  *)
    die "Homebrew remote is '$ACTUAL_BREW_REMOTE' — not an official Homebrew remote. Possible tampering!"
    ;;
esac
sec "Homebrew remote origin: OK ($ACTUAL_BREW_REMOTE)"
record_sha "brew" "$BREW_BIN"

# 1b. Enforce tap allowlist — BLOCK on untrusted taps, don't just warn
# Add any taps you explicitly trust to this list.
ALLOWED_TAPS=()
while IFS= read -r _line; do
  [[ -n "$_line" ]] && ALLOWED_TAPS+=("$_line")
done < <(load_list "allowed-taps")

tap_remote() {
  # tap_remote <user/repo> → git remote URL of the tap's local checkout
  local tap="$1" user="${1%%/*}" repo="${1#*/}"
  local dir="$(brew --repository 2>/dev/null)/Library/Taps/${user}/homebrew-${repo}"
  [[ -d "$dir" ]] || return 1
  git -C "$dir" remote get-url origin 2>/dev/null || return 1
}

sec "Checking Homebrew taps against allowlist…"
SECURITY_FAIL=false
while IFS= read -r tap; do
  [[ -z "$tap" ]] && continue
  allowed=false
  reason=""

  # Official taps are trusted by REMOTE URL, not by name. This is stricter than
  # an name allowlist: a local tap called "homebrew/core" whose remote points
  # somewhere else is caught here, where a name check would wave it through.
  remote="$(tap_remote "$tap" || echo "")"
  case "$remote" in
    https://github.com/Homebrew/*|git@github.com:Homebrew/*)
      allowed=true; reason="official (remote verified)" ;;
  esac

  # Third-party taps must be named explicitly in the allowlist.
  if ! $allowed; then
    for a in "${ALLOWED_TAPS[@]}"; do
      [[ "$tap" == "$a" ]] && allowed=true && reason="allowlisted" && break
    done
  fi

  if $allowed; then
    sec "  tap OK: $tap ($reason)"
  else
    err "UNTRUSTED TAP DETECTED: '$tap'${remote:+ → $remote}"
    detail "→ Remove it:   brew untap '$tap'"
    detail "→ Or trust it: echo '$tap' >> ${CONFIG_DIR}/allowed-taps"
    SECURITY_FAIL=true
  fi
done < <(brew tap 2>/dev/null)

if $SECURITY_FAIL; then
  # Read-only modes must finish and report everything they found. Aborting on
  # the first problem hides the rest of the audit, which is the whole point.
  if $DRY || $AUDIT_ONLY; then
    warn "Untrusted taps present (continuing — read-only mode)"
  else
    die "Aborting: untrusted Homebrew taps present. Remove them before updating."
  fi
fi

# 1c. Check for deprecated/orphaned formulae (informational, not blocking)
sec "Running brew doctor…"
DOCTOR_OUT=$(brew doctor 2>&1 || true)
if echo "$DOCTOR_OUT" | grep -q "Warning:"; then
  warn "brew doctor found warnings — review:"
  echo "$DOCTOR_OUT" | grep -A2 "Warning:" | while IFS= read -r line; do
    [[ -z "$line" || "$line" == "--" ]] && continue
    detail "$line"
  done
else
  sec "brew doctor: clean"
fi

# 1d. Verify macOS SIP is enabled
SIP_STATUS=$(csrutil status 2>/dev/null || echo "unknown")
if echo "$SIP_STATUS" | grep -q "enabled"; then
  sec "SIP (System Integrity Protection): enabled ✓"
else
  warn "SIP status: $SIP_STATUS — consider enabling SIP for stronger system protection"
fi

# 1e. Verify Gatekeeper is enabled
GK_STATUS=$(spctl --status 2>/dev/null || echo "unknown")
if echo "$GK_STATUS" | grep -q "enabled"; then
  sec "Gatekeeper: enabled ✓"
else
  warn "Gatekeeper: $GK_STATUS — consider enabling: sudo spctl --master-enable"
fi

# 1f. Check for world-writable directories in PATH (path-hijack vector)
sec "Checking PATH for world-writable directories…"
IFS=':' read -ra PATH_DIRS <<< "$PATH"
for dir in "${PATH_DIRS[@]}"; do
  if [[ -d "$dir" ]]; then
    perms=$(stat -f "%Sp" "$dir" 2>/dev/null || stat -c "%A" "$dir" 2>/dev/null || echo "unknown")
    if _other_writable "$perms"; then
      warn "World-writable PATH dir: $dir ($perms) — PATH hijack risk!"
    fi
  fi
done
sec "PATH check complete"

if $AUDIT_ONLY; then
  log "Audit-only mode — exiting without updates"
  _finish
  exit 0
fi

# ── 2. HOMEBREW ───────────────────────────────────────────────────────────────
phase "HOMEBREW"

# Fetch latest metadata (signed by Homebrew's CDN cert)
run "brew update (fetch signed metadata)" brew update

# Upgrade formulae — Homebrew verifies SHA256 of every bottle before install.
# Capture output so we can detect and repair broken symlinks post-upgrade.
brew_upgrade_formulae() {
  log "brew upgrade formulae"
  if $DRY; then echo "  (dry-run) brew upgrade"; return; fi

  local out
  out=$(brew upgrade 2>&1) \
    && ok "brew upgrade formulae" \
    || err "brew upgrade formulae had errors — attempting link repair"
  echo "$out"

  # 1. Auto-run any "brew unlink <formula>" suggestions (e.g. old versioned kegs)
  while IFS= read -r old_keg; do
    warn "  Unlinking conflicting keg: $old_keg"
    brew unlink "$old_keg" 2>/dev/null \
      && ok "  Unlinked: $old_keg" \
      || warn "  Could not unlink $old_keg — run manually: brew unlink $old_keg"
  done < <(grep -oE 'brew unlink [^[:space:]]+' <<< "$out" | awk '{print $3}' | sort -u)

  # 2. Re-link any formulae whose bottle poured but link step failed.
  #    Output pattern: "==> Pouring formula--version..." then "brew link step did not complete"
  # Pouring line format: "==> Pouring python@3.13--3.13.13.tahoe.bottle.tar.gz"
  # Formula name ends at "--" (double-dash separates name from version).
  local current_formula="" link_failed=false
  local -a failed_formulae=()
  while IFS= read -r line; do
    if [[ "$line" =~ ^"==> Pouring "(.+)"--" ]]; then
      # flush previous formula if its link step failed
      if [[ "$link_failed" == true && -n "$current_formula" ]]; then
        failed_formulae+=("$current_formula")
      fi
      current_formula="${BASH_REMATCH[1]}"
      link_failed=false
    elif [[ "$line" == *"brew link"*"step did not complete"* ]]; then
      link_failed=true
    fi
  done <<< "$out"
  if [[ "$link_failed" == true && -n "$current_formula" ]]; then
    failed_formulae+=("$current_formula")
  fi
  if (( ${#failed_formulae[@]} > 0 )); then
    for formula in "${failed_formulae[@]}"; do
      warn "  Link failure for '$formula' — attempting brew link --overwrite"
      brew link --overwrite "$formula" 2>/dev/null \
        && ok "  Relinked: $formula" \
        || warn "  Could not relink $formula — manual fix: brew link --overwrite $formula"
    done
  fi
}
$DRY || $AUDIT_ONLY || sudo -v  # refresh TTY-bound sudo token before brew upgrade (background keepalive uses a different tty)
brew_upgrade_formulae

# Upgrade casks — same bottle verification
# Run outside `run` helper so interrupts/errors don't abort the script via set -e
brew_upgrade_casks() {
  log "brew upgrade casks"
  if $DRY; then echo "  (dry-run) brew upgrade --cask --greedy"; return; fi
  brew upgrade --cask --greedy \
    && ok "brew upgrade casks" \
    || warn "brew upgrade casks had errors (exit $?) — continuing"
}
$DRY || $AUDIT_ONLY || sudo -v  # refresh TTY-bound sudo token before cask upgrade
brew_upgrade_casks

# Cleanup old versions — fix any permission issues on Cellar first
brew_cleanup_safe() {
  log "brew cleanup"
  if $DRY; then echo "  (dry-run) brew cleanup --prune=7"; return; fi

  # Cellar permission problems (e.g. leftover root-owned dirs) cause cleanup to fail.
  # Fix ownership silently; if sudo is unavailable this is a no-op.
  local cellar
  cellar="$(brew --cellar 2>/dev/null || echo "")"
  if [[ -n "$cellar" && -d "$cellar" ]]; then
    sudo chown -R "$(whoami)" "$cellar" 2>/dev/null \
      && log "  Cellar ownership corrected ($cellar)" \
      || true
  fi

  brew cleanup --prune=7 \
    && ok "brew cleanup" \
    || err "brew cleanup failed — some old kegs may remain in /usr/local/Cellar"
}
brew_cleanup_safe

# Post-upgrade audit: surface any newly deprecated packages
DEPRECATED=$(brew list --formula 2>/dev/null | xargs brew info --json=v2 2>/dev/null \
  | python3 -c "
import sys, json
data = json.load(sys.stdin)
for f in data.get('formulae', []):
    if f.get('deprecated') or f.get('disabled'):
        print(f['name'])
" 2>/dev/null || true)
if [[ -n "$DEPRECATED" ]]; then
  warn "Deprecated/disabled formulae installed — find replacements:"
  echo "$DEPRECATED" | while IFS= read -r f; do warn "  $f"; done
fi

record_sha "brew-post" "$BREW_BIN"

# ── 3. uv (Python package/project manager) ────────────────────────────────────
phase "uv"
# uv self-update fetches from https://github.com/astral-sh/uv/releases
# Binaries are signed with Sigstore (cosign) — verified automatically by uv
if require uv "brew install uv"; then
  UV_BIN=$(command -v uv)
  record_sha "uv-pre" "$UV_BIN"
  run "uv self update (Sigstore-verified)" uv self update
  record_sha "uv-post" "$UV_BIN"
fi

# ── 4. pyenv ──────────────────────────────────────────────────────────────────
phase "pyenv"
# Managed via Homebrew — inherits Homebrew's SHA256 bottle verification
if require pyenv "brew install pyenv"; then
  run "pyenv (via brew)" brew upgrade pyenv
fi

# ── 5. rustup / Rust toolchain ────────────────────────────────────────────────
phase "Rust / rustup"
# rustup update fetches from static.rust-lang.org over TLS; each component
# is verified against a SHA256 manifest signed with the Rust project's key.
if require rustup "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh"; then
  RUSTUP_BIN=$(command -v rustup)
  record_sha "rustup-pre" "$RUSTUP_BIN"
  # --no-self-update first so we can log the toolchain update separately
  run "rustup toolchain update (manifest-signed)" rustup update
  record_sha "rustup-post" "$RUSTUP_BIN"
fi

# ── 6. npm global packages ────────────────────────────────────────────────────
phase "npm globals"
# Security controls applied:
#   --ignore-scripts  → prevents postinstall/preinstall script execution
#                       (primary supply-chain attack vector in npm)
#   npm audit         → checks installed packages against NIST NVD / GitHub Advisory DB
#
# ONLY packages in this explicit allowlist are updated.
# Never run `npm update -g` without a pinned list.
NPM_PINNED=()
while IFS= read -r _line; do
  [[ -n "$_line" ]] && NPM_PINNED+=("$_line")
done < <(load_list "npm-pinned")

if require npm "brew install node"; then
  log "npm globals (pinned list, --ignore-scripts)"

  # Packages whose postinstall is required for functionality.
  # These get --allow-scripts=<pkg> instead of --ignore-scripts.
  # Audited: install.cjs downloads a platform-native binary from downloads.claude.ai
  NEEDS_POSTINSTALL=(
    "@anthropic-ai/claude-code"
  )

  for pkg in "${NPM_PINNED[@]}"; do
    # Check if this package needs postinstall
    needs_scripts=false
    for allowed_pkg in "${NEEDS_POSTINSTALL[@]}"; do
      if [[ "$pkg" == "$allowed_pkg" ]]; then
        needs_scripts=true
        break
      fi
    done

    if $DRY; then
      if $needs_scripts; then
        echo "  (dry-run) npm install -g --allow-scripts=${pkg} ${pkg}@latest"
      else
        echo "  (dry-run) npm install -g --ignore-scripts ${pkg}@latest"
      fi
    else
      if $needs_scripts; then
        if npm install -g --allow-scripts="${pkg}" "${pkg}@latest" 2>/dev/null; then
          ok "npm: $pkg (with postinstall)"
        else
          warn "npm: failed to update $pkg"
        fi
      else
        if npm install -g --ignore-scripts "${pkg}@latest" 2>/dev/null; then
          ok "npm: $pkg"
        else
          warn "npm: failed to update $pkg"
        fi
      fi
    fi
  done

  # Run npm audit on global packages to surface known CVEs
  log "npm audit (global)"
  if $DRY; then
    echo "  (dry-run) npm audit --global"
  else
    npm audit --global 2>/dev/null || warn "npm audit found issues — review above output"
  fi
fi

